# Settings of this Straum node, read by straum.service. Every setting is
# described in docs/configuration.md. The node refuses to start until the
# required ones below are set; then: systemctl enable --now straum
#
# The path is experimental and not production-ready: acknowledge it with 1.
#STRAUM_EXPERIMENTAL_CLUSTER=1
#
# This node's id (0-255) and every voter, this node included (odd, at least 3).
#STRAUM_CLUSTER_NODE_ID=0
#STRAUM_CLUSTER_PEERS=0=10.0.0.10:7000,1=10.0.0.11:7000,2=10.0.0.12:7000
#
# Where links and metrics listen. Anything beyond loopback is refused unless
# STRAUM_CLUSTER_UNAUTHENTICATED_NETWORK=1, or, for the links and peers,
# the node TLS files below: metrics are neither authenticated nor encrypted,
# so only on a network you trust.
#STRAUM_CLUSTER_LISTEN=0.0.0.0:7000
#STRAUM_CLUSTER_METRICS_LISTEN=127.0.0.1:9100
#STRAUM_CLUSTER_UNAUTHENTICATED_NETWORK=0
#
# TLS between nodes (PEM files, all three or none; docs/configuration.md,
# "Node certificates"). With them, STRAUM_CLUSTER_TAKEOVER_TICKS must be 4
# or more.
#STRAUM_CLUSTER_TLS_CERT_PATH=/etc/straum/tls/node.pem
#STRAUM_CLUSTER_TLS_KEY_PATH=/etc/straum/tls/node.key
#STRAUM_CLUSTER_TLS_CA_PATH=/etc/straum/tls/ca.pem
#STRAUM_CLUSTER_TAKEOVER_TICKS=4
#
# STRAUM_CLUSTER_DATA_DIR is /var/lib/straum (set by the unit).
