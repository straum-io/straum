# Settings of this Straum node, read by straum.service. Every setting is
# described in docs/configuration.md. The node refuses to start until the
# required ones below are set; then: systemctl enable --now straum
#
# The path is experimental and not production-ready: acknowledge it with 1.
#STRAUM_EXPERIMENTAL_CLUSTER=1
#
# This node's id (0-255) and every voter, this node included (odd, at least 3).
#STRAUM_CLUSTER_NODE_ID=0
#STRAUM_CLUSTER_PEERS=0=10.0.0.10:7000,1=10.0.0.11:7000,2=10.0.0.12:7000
#
# Where links, MQTT clients and metrics listen. Anything beyond loopback is
# refused unless STRAUM_CLUSTER_UNAUTHENTICATED_NETWORK=1: links and metrics
# are neither authenticated nor encrypted, so only on a network you trust.
# The MQTT listener alone may bind beyond loopback without it once TLS and
# a password file (with anonymous clients refused) are set, below.
#STRAUM_CLUSTER_LISTEN=0.0.0.0:7000
#STRAUM_CLUSTER_MQTT_LISTEN=127.0.0.1:1883
#STRAUM_CLUSTER_METRICS_LISTEN=127.0.0.1:9100
#STRAUM_CLUSTER_UNAUTHENTICATED_NETWORK=0
#
# MQTT client TLS (PEM files, both or neither) and credentials. A hash for
# the password file: straum-server hash-password  (reads the password on stdin).
#STRAUM_TLS_CERT_PATH=/etc/straum/tls/cert.pem
#STRAUM_TLS_KEY_PATH=/etc/straum/tls/key.pem
#STRAUM_AUTH_PASSWORD_FILE=/etc/straum/passwords
#STRAUM_AUTH_ACL_FILE=/etc/straum/acl
#STRAUM_AUTH_ALLOW_ANONYMOUS=0
#
# STRAUM_CLUSTER_DATA_DIR is /var/lib/straum (set by the unit).
