{
  "name": "request_errors",
  "description": "UnsupportedAckLevel, MalformedRequest, Unsupported and Forbidden; the connection stays usable.",
  "steps": [
    {
      "connect": "a"
    },
    {
      "send": "a",
      "id": "hello",
      "request": {
        "type": "Hello",
        "body": {
          "min_version": 0,
          "max_version": 0,
          "client_name": "conformance",
          "auth_mechanism": "none",
          "auth_payload": ""
        }
      }
    },
    {
      "expect": "a",
      "id": "hello",
      "response": {
        "type": "HelloOk",
        "body": {
          "version": 0,
          "cluster_id": "conformance",
          "node_id": 1
        }
      }
    },
    {
      "send": "a",
      "id": "create",
      "request": {
        "type": "CreateTopic",
        "body": {
          "name": "r",
          "partitions": 1,
          "replication_factor": 1,
          "retention_ms": "0"
        }
      }
    },
    {
      "expect": "a",
      "id": "create",
      "response": {
        "type": "CreateTopicOk"
      }
    },
    {
      "send": "a",
      "id": "written",
      "request": {
        "type": "Produce",
        "body": {
          "topic": "r",
          "partition": 0,
          "producer_id": "1",
          "producer_seq": "1",
          "ack_level": 0,
          "expected_leader_epoch": 0,
          "timeout_ms": 0,
          "messages": [
            {
              "key": null,
              "headers": [],
              "body": "78"
            }
          ]
        }
      }
    },
    {
      "expect": "a",
      "id": "written",
      "response": {
        "type": "Error",
        "body": {
          "code": "UnsupportedAckLevel"
        }
      }
    },
    {
      "send": "a",
      "id": "replicated",
      "request": {
        "type": "Produce",
        "body": {
          "topic": "r",
          "partition": 0,
          "producer_id": "1",
          "producer_seq": "1",
          "ack_level": 2,
          "expected_leader_epoch": 0,
          "timeout_ms": 0,
          "messages": [
            {
              "key": null,
              "headers": [],
              "body": "78"
            }
          ]
        }
      }
    },
