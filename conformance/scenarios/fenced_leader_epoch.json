{
  "name": "fenced_leader_epoch",
  "description": "An expected_leader_epoch other than 0 and the partition's epoch (1) is FencedLeaderEpoch with the current leader and epoch.",
  "steps": [
    {
      "connect": "a"
    },
    {
      "send": "a",
      "id": "hello",
      "request": {
        "type": "Hello",
        "body": {
          "min_version": 0,
          "max_version": 0,
          "client_name": "conformance",
          "auth_mechanism": "none",
          "auth_payload": ""
        }
      }
    },
    {
      "expect": "a",
      "id": "hello",
      "response": {
        "type": "HelloOk",
        "body": {
          "version": 0,
          "cluster_id": "conformance",
          "node_id": 1
        }
      }
    },
    {
      "send": "a",
      "id": "create",
      "request": {
        "type": "CreateTopic",
        "body": {
          "name": "e",
          "partitions": 1,
          "replication_factor": 1,
          "retention_ms": "0"
        }
      }
    },
    {
      "expect": "a",
      "id": "create",
      "response": {
        "type": "CreateTopicOk"
      }
    },
    {
      "send": "a",
      "id": "p",
      "request": {
        "type": "Produce",
        "body": {
          "topic": "e",
          "partition": 0,
          "producer_id": "1",
          "producer_seq": "1",
          "ack_level": 1,
          "expected_leader_epoch": 2,
          "timeout_ms": 0,
          "messages": [
            {
              "key": null,
              "headers": [],
              "body": "78"
            }
          ]
        }
      }
    },
    {
      "expect": "a",
      "id": "p",
      "response": {
        "type": "Error",
        "body": {
          "code": "FencedLeaderEpoch",
          "leader_node_id": 1,
          "leader_epoch": 1
        }
      }
    },
    {
      "send": "a",
      "id": "f",
      "request": {
        "type": "Fetch",
        "body": {
          "topic": "e",
          "partition": 0,
          "from_seq": "0",
          "max_bytes": 1048576,
          "max_wait_ms": 0,
          "expected_leader_epoch": 9
        }
      }
    },
    {
      "expect": "a",
      "id": "f",
      "response": {
        "type": "Error",
        "body": {
          "code": "FencedLeaderEpoch",
          "leader_node_id": 1,
          "leader_epoch": 1
        }
      }
    },
    {
      "send": "a",
      "id": "ok",
      "request": {
        "type": "Produce",
        "body": {
          "topic": "e",
          "partition": 0,
          "producer_id": "1",
          "producer_seq": "1",
          "ack_level": 1,
          "expected_leader_epoch": 1,
          "timeout_ms": 0,
          "messages": [
            {
              "key": null,
              "headers": [],
              "body": "78"
            }
          ]
        }
      }
    },
    {
      "expect": "a",
      "id": "ok",
      "response": {
        "type": "ProduceOk",
        "body": {
          "base_seq": "0",
          "leader_epoch": 1
        }
      }
    },
    {
      "send": "a",
      "id": "fok",
      "request": {
        "type": "Fetch",
        "body": {
          "topic": "e",
          "partition": 0,
          "from_seq": "0",
          "max_bytes": 1048576,
          "max_wait_ms": 0,
          "expected_leader_epoch": 1
        }
      }
    },
    {
      "expect": "a",
      "id": "fok",
      "response": {
        "type": "FetchOk",
        "body": {
          "leader_epoch": 1,
          "messages": {
            "$len": 1
          }
        }
      }
    }
  ]
}
