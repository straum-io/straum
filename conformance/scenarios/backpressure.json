{
  "name": "backpressure",
  "description": "A client that floods Fetch and Produce and never reads responses: once its unread responses fill the socket, the broker stops reading from it; pending bytes stay within max_pending_bytes, and other connections are still served.",
  "broker": {
    "max_frame_bytes": 4096,
    "max_fetch_bytes": 1024,
    "max_inflight_bytes": 8192,
    "max_pending_bytes": 4096,
    "max_message_bytes": 4096
  },
  "steps": [
    {
      "connect": "a"
    },
    {
      "send": "a",
      "id": "hello",
      "request": {
        "type": "Hello",
        "body": {
          "min_version": 0,
          "max_version": 0,
          "client_name": "conformance",
          "auth_mechanism": "none",
          "auth_payload": ""
        }
      }
    },
    {
      "expect": "a",
      "id": "hello",
      "response": {
        "type": "HelloOk",
        "body": {
          "version": 0,
          "cluster_id": "conformance",
          "node_id": 1
        }
      }
    },
    {
      "send": "a",
      "id": "create",
      "request": {
        "type": "CreateTopic",
        "body": {
          "name": "flood",
          "partitions": 1,
          "replication_factor": 1,
          "retention_ms": "0"
        }
      }
    },
    {
      "expect": "a",
      "id": "create",
      "response": {
        "type": "CreateTopicOk"
      }
    },
    {
      "send": "a",
      "id": "seed",
      "request": {
        "type": "Produce",
        "body": {
          "topic": "flood",
          "partition": 0,
          "producer_id": "1",
          "producer_seq": "1",
          "ack_level": 1,
          "expected_leader_epoch": 0,
          "timeout_ms": 0,
          "messages": [
            {
              "key": null,
              "headers": [],
              "body": ""
            }
          ]
        }
      }
    },
    {
      "expect": "a",
      "id": "seed",
      "response": {
        "type": "ProduceOk",
        "body": {
          "base_seq": "0"
        }
      }
    },
    {
      "connect": "b"
    },
    {
      "send": "b",
      "id": "hello-b",
      "request": {
        "type": "Hello",
        "body": {
          "min_version": 0,
          "max_version": 0,
          "client_name": "conformance",
          "auth_mechanism": "none",
          "auth_payload": ""
        }
      }
    },
    {
      "expect": "b",
      "id": "hello-b",
      "response": {
        "type": "HelloOk",
        "body": {
          "version": 0,
          "cluster_id": "conformance",
          "node_id": 1
        }
      }
    },
    {
      "repeat": 10000,
      "steps": [
        {
          "send": "a",
          "id": "f",
          "request": {
            "type": "Fetch",
            "body": {
              "topic": "flood",
              "partition": 0,
              "from_seq": "0",
              "max_bytes": 1048576,
              "max_wait_ms": 0,
              "expected_leader_epoch": 0
            }
          }
        },
        {
          "send": "a",
          "id": "p",
          "request": {
            "type": "Produce",
            "body": {
              "topic": "flood",
              "partition": 0,
              "producer_id": "1",
              "producer_seq": "1",
              "ack_level": 1,
              "expected_leader_epoch": 0,
              "timeout_ms": 0,
              "messages": [
                {
                  "key": null,
                  "headers": [],
                  "body": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "sleep_ms": 2000
    },
    {
      "send": "b",
      "id": "s",
      "request": {
        "type": "BrokerStats"
      }
    },
    {
      "expect": "b",
      "id": "s",
      "response": {
        "type": "BrokerStatsOk",
        "body": {
          "pending_bytes": {
            "$le": 4096
          },
          "pending_bytes_peak": {
            "$le": 4096
          },
          "max_pending_bytes": "4096",
          "produce_requests": {
            "$le": 10000
          }
        }
      },
      "within_ms": 2000
    },
    {
      "send": "b",
      "id": "ping",
      "request": {
        "type": "Ping",
        "body": {
          "nonce": "1"
        }
      }
    },
    {
      "expect": "b",
      "id": "ping",
      "response": {
        "type": "Pong"
      },
      "within_ms": 2000
    }
  ]
}
