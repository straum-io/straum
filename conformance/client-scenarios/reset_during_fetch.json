{
  "name": "reset_during_fetch",
  "description": "The connection is reset before a Fetch is answered: the client reconnects and fetches from the same seq.",
  "client": {
    "op": "fetch",
    "topic": "t",
    "partition": 0,
    "from_seq": "3",
    "max_bytes": 1024,
    "max_wait_ms": 0
  },
  "server": [
    {
      "accept": true
    },
    {
      "expect": {
        "type": "Hello",
        "body": {
          "min_version": 0,
          "auth_mechanism": "none"
        }
      },
      "reply": {
        "type": "HelloOk",
        "body": {
          "version": 0,
          "cluster_id": "fake",
          "node_id": 1,
          "max_frame_bytes": 8388608,
          "max_message_bytes": 1048576
        }
      }
    },
    {
      "expect": {
        "type": "Fetch",
        "body": {
          "from_seq": "3"
        }
      },
      "close": true
    },
    {
      "accept": true
    },
    {
      "expect": {
        "type": "Hello",
        "body": {
          "min_version": 0,
          "auth_mechanism": "none"
        }
      },
      "reply": {
        "type": "HelloOk",
        "body": {
          "version": 0,
          "cluster_id": "fake",
          "node_id": 1,
          "max_frame_bytes": 8388608,
          "max_message_bytes": 1048576
        }
      }
    },
    {
      "expect": {
        "type": "Fetch",
        "body": {
          "from_seq": "3"
        }
      },
      "reply": {
        "type": "FetchOk",
        "body": {
          "leader_epoch": 1,
          "start_seq": "0",
          "next_seq": "4",
          "messages": [
            {
              "seq": "3",
              "timestamp_ms": "1",
              "key": null,
              "headers": [],
              "body": "78"
            }
          ]
        }
      }
    }
  ],
  "result": {
    "ok": {
      "next_seq": "4",
      "messages": {
        "$len": 1
      }
    }
  }
}
