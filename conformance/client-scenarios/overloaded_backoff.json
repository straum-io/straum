    {
      "expect": {
        "type": "Produce",
        "body": {
          "topic": "t",
          "partition": 0,
          "producer_id": "77",
          "producer_seq": "5",
          "ack_level": 1,
          "expected_leader_epoch": 0,
          "messages": [
            {
              "key": "6b",
              "headers": [],
              "body": "68656c6c6f"
